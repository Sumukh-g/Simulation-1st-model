# Evidence service image.
#
# Identical to the base image plus the embedding stack. It is separate because
# sentence-transformers pulls in torch, which roughly triples the image size and
# is of no use to any other service.
#
# Build with the repository root as context:
#   docker build -f docker/Dockerfile.evidence -t gsip-evidence .

FROM gsip-app:latest

USER root
RUN pip install --no-cache-dir "sentence-transformers==2.7.0"
USER gsip

EXPOSE 8002

CMD ["uvicorn", "services.evidence.main:app", "--host", "0.0.0.0", "--port", "8002"]
